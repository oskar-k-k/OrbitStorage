# Copy to .env; replace every placeholder with fresh random values.
DATABASE_PASSWORD=replace-with-a-random-database-password
ORBIT_PORT=18080
# Generate: openssl rand -hex 32
ORBIT_ADMIN_KEY=replace-with-at-least-32-random-characters
ORBIT_MONITORING_KEY=
# Generate: openssl rand -base64 32 (32 decoded bytes; keep stable across restarts)
ORBIT_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
ORBIT_GLOBAL_BUDGET=107374182400
ORBIT_WARNING_PERCENT=80
ORBIT_BLOCKING_PERCENT=95
ORBIT_MAX_REQUEST_BYTES=104857600
ORBIT_RECONCILIATION_DELAY_MS=300000
ORBIT_DOCS_ENABLED=false
